
# Reference for Render's Environment settings, not a file to commit with secrets.
# The application reads process environment variables; it does not load dotenv.
APP_ENV=production
APP_ORIGIN=https://YOUR-FRONTEND.vercel.app
ALLOWED_HOSTS=YOUR-API.onrender.com,YOUR-FRONTEND.vercel.app,localhost,127.0.0.1

# Render supplies RENDER_EXTERNAL_HOSTNAME; the API derives the direct socket URL.
# Set this for another host or a custom backend domain (no trailing path).
# ROOM_WEBSOCKET_ORIGIN=wss://YOUR-API.example.com

# Optional room voice. Set all three in the backend's private environment.
# These are LiveKit credentials, never frontend VITE_* values.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional when browsers need a different URL than the backend, e.g. local Docker.
# LIVEKIT_PUBLIC_URL=wss://YOUR-PROJECT.livekit.cloud

# Standalone cricket simulation service. Keep its key only on the backend.
# ODI requests become 50-over engine matches; T20 World Cup and IPL use T20.
OUT_ENGINE_URL=https://out-engine.onrender.com
OUT_ENGINE_API_KEY=
OUT_ENGINE_TIMEOUT_SECONDS=90

# Copy Render's Internal Database URL, change only its scheme to
# postgresql+psycopg://, and append ?sslmode=require (or &sslmode=require
# if it already has query parameters). Keep its actual username/password/host/db.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@INTERNAL-HOST/DATABASE?sslmode=require

# For separate migration/runtime roles, set this to the database owner URL.
# See the Production database permissions section in docs/DEPLOYMENT.md.
# MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER:PASSWORD@INTERNAL-HOST/DATABASE?sslmode=require
