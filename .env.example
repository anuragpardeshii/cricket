# Local Docker Compose settings. This file contains no real credentials.
# Run `make init` to generate .env with three independent random passwords.
# Then add/change the optional settings below in your generated .env.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
TEST_POSTGRES_PASSWORD=
WEB_PORT=5173
WEB_HOST=localhost
BIND_ADDRESS=127.0.0.1
# Local LiveKit advertises this IP for browser media connections.
# For LAN development set it to this computer's LAN IP and use HTTPS for the mic.
LIVEKIT_NODE_IP=127.0.0.1

# Hosted deployment uses different variables: see backend/.env.example
# and docs/DEPLOYMENT.md. Never upload your real .env to GitHub.
